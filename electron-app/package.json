{
  "name": "momentplan",
  "productName": "MomentPlan",
  "version": "0.99.02",
  "private": true,
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win" },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" },
  "build": {
    "appId": "com.momentplan.app",
    "productName": "MomentPlan",
    "files": ["main.js", "preload.js", "dist/**", "icon.png", "icon.ico"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "signAndEditExecutable": true, "icon": "build/mp-icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "createDesktopShortcut": true, "shortcutName": "MomentPlan", "license": "license.txt", "installerIcon": "build/mp-icon.ico", "uninstallerIcon": "build/mp-icon.ico", "artifactName": "MomentPlan-Setup-${version}-${arch}.${ext}" },
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "category": "public.app-category.productivity", "identity": null, "icon": "build/source-icon.png" },
    "dmg": { "title": "MomentPlan" },
    "extraResources": [
      { "from": "../docs/EULA.txt", "to": "docs/EULA.txt" },
      { "from": "../docs/개인정보처리방침.txt", "to": "docs/개인정보처리방침.txt" },
      { "from": "../docs/THIRD-PARTY-NOTICES.txt", "to": "docs/THIRD-PARTY-NOTICES.txt" }
    ],
    "directories": { "output": "release" }
  }
}
